{
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "convex": "^1.46.0",
    "prettier": "^3.1.0",
    "turbo": "^2.11.6"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.8.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
